(graph demo.pat.targets:canvas
  (inlet0 (inlet "list" "the figures to draw"))
  (expr1 (expr (set! state (list (append '(panel (@ (x 0 1) (y 0 1))) $figures)))))
  (bind2 (bind 1))
  (expr3 (expr 280))
  (expr4 (expr 120))
  (ref5 (ref ui.canvas #:sync))
  (gui6 gui)
  (comment7 (comment "# canvas\nthe last step of a column, and the only one that\nknows the screen. it keeps one panel in its state." 420 57))
  (-> inlet0 expr1)
  (-> bind2 ref5)
  (-> expr3 (ref5 4))
  (-> expr4 (ref5 5))
  (-> ref5 gui6))

(graph demo.pat.targets:screen
  (inlet0 (inlet "event" "an event alive at the playhead"))
  (ref1 (ref pat.eventvalue #:sync))
  (ref2 (ref pat.eventphase #:sync))
  (get3 (get "note"))
  (get4 (get "level"))
  (expr5 (expr (/ (- $note 60) 13.0)))
  (expr6 (expr (* $level (- 1.0 $phase))))
  (expr7 (expr (list 'rect $x 0.0 (+ $x 0.06) $y)))
  (outlet8 (outlet "figure" "a bar that falls over the life of the event"))
  (comment9 (comment "# screen\nnote picks the place of a bar. level sets its\nheight, which falls over the life of the event." 400 57))
