(graph pat.event
  (expr0 (expr (pat/event $value $active $whole) #:require "gantz/pattern"))
  (inlet1 (inlet "value" "event value"))
  (inlet2 (inlet "span" "the active span"))
  (inlet3 (inlet "span" "the whole span, or #f for a signal"))
  (outlet4 (outlet "event" "the event"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> expr0 outlet4))

(graph pat.eventactive
  (expr0 (expr (pat/event-active $e) #:require "gantz/pattern"))
  (inlet1 (inlet "event" "an event"))
  (outlet2 (outlet "span" "the active span"))
