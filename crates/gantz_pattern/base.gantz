(graph demo.pat.voices:bell
  (inlet0 (inlet "schedule" "(seconds note) pairs"))
  (fnref1 (fn-ref mtof #:sync))
  (ref2 (ref sched.map #:sync))
  (ref3 (ref sched.trig #:sync))
  (~dc4 ~dc)
  (~sinosc5 ~sinosc)
  (~envgen6 (~envgen #:segs ((0.3 0.005) (0 1.5 -4))))
  (~mul7 ~mul)
  (outlet8 (outlet "signal" "the bell"))
  (comment9 (comment "# bell\n`mtof` turns each note into a pitch, and\n`sched.trig` opens the gate of the envelope for\n10 ms at each note. `~dc` holds the pitch. it\nstarts at 0 hz, so the bell is silent until its\nfirst event." 420 110))
  (expr10 (expr 0.01))
  (-> inlet0 fnref1)
  (-> inlet0 (ref2 1))
  (-> inlet0 ref3)
  (-> expr10 (ref3 1))
  (-> fnref1 ref2)
  (-> ref2 ~dc4)
  (-> ~dc4 ~sinosc5)
  (-> ref3 ~envgen6)
  (-> ~sinosc5 ~mul7)
  (-> ~envgen6 (~mul7 1))
  (-> ~mul7 outlet8))

(graph demo.sched
  (tick-bang0 (tick-bang #:rate 60))
  (number1 (number #:min 0.25 #:max 2 #:init 0.5 #:label "cps" #:input bang #:no-push-eval))
  (ref2 (ref pat.window #:sync))
  (pat.mini3 (pat.mini "48 [43 45] <67 72> [64 69]"))
  (pat.key4 (pat.key "note"))
  (pat.mini5 (pat.mini "0 1"))
  (pat.key6 (pat.key "voice"))
  (ref7 (ref pat.with #:sync))
  (pat.lensecs8 (pat.lensecs "dur"))
  (ref9 (ref pat.query #:sync))
  (ref10 (ref pat.sched #:sync))
  (sched.split11 (sched.split "voice" 2))
  (sched.pick12 (sched.pick "note"))
  (sched.gate13 (sched.gate "dur"))
  (ref14 (ref demo.sched:voice #:sync))
  (number15 (number #:min 36 #:max 84 #:init 64 #:label "over" #:input bang #:no-push-eval))
  (sched.pick16 (sched.pick "note"))
  (fnref17 (fn-ref gt #:sync))
  (ref18 (ref sched.filter #:sync))
  (number19 (number #:min 0.01 #:max 0.5 #:init 0.01 #:label "pulse" #:input bang #:no-push-eval))
  (ref20 (ref sched.trig #:sync))
  (ref21 (ref demo.sched:voice #:sync))
  (~out22 ~out)
  (comment23 (comment "# schedules\n`pat.sched` gives the notes of each tick as a\nschedule of (seconds map) pairs. `sched.split`\nsends each note to a voice by its `voice` key." 420 76))
  (comment24 (comment "bass: `sched.gate` holds each note for the\nseconds that `pat.lensecs` puts under `dur`" 380 38))
  (comment25 (comment "bell: `sched.filter` keeps the notes over a\npitch, and `sched.trig` gives each a pulse" 380 38))
  (-> tick-bang0 number1)
  (-> tick-bang0 ref2)
  (-> tick-bang0 pat.mini3)
  (-> tick-bang0 pat.mini5)
  (-> tick-bang0 number15)
  (-> tick-bang0 number19)
  (-> number1 (ref2 1))
  (-> number1 (pat.lensecs8 1))
  (-> (ref2 3) (pat.lensecs8 2))
  (-> pat.mini3 pat.key4)
  (-> pat.mini5 pat.key6)
  (-> pat.key4 ref7)
  (-> pat.key6 (ref7 1))
  (-> ref7 pat.lensecs8)
  (-> pat.lensecs8 ref9)
  (-> ref2 (ref9 1))
  (-> ref9 ref10)
  (-> (ref2 1) (ref10 1))
  (-> (ref2 2) (ref10 2))
  (-> ref10 sched.split11)
  (-> sched.split11 sched.pick12)
  (-> sched.split11 sched.gate13)
  (-> sched.pick12 ref14)
  (-> sched.gate13 (ref14 1))
  (-> (sched.split11 1) sched.pick16)
  (-> number15 (fnref17 2))
  (-> fnref17 ref18)
  (-> sched.pick16 (ref18 1))
  (-> ref18 ref20)
  (-> number19 (ref20 1))
  (-> ref18 ref21)
  (-> ref20 (ref21 1))
  (-> ref14 ~out22)
  (-> ref21 ~out22))

(graph demo.sched:voice
  (inlet0 (inlet "schedule" "(seconds note) pairs"))
  (inlet1 (inlet "schedule" "(seconds gate) pairs"))
  (fnref2 (fn-ref mtof #:sync))
  (ref3 (ref sched.map #:sync))
  (~dc4 ~dc)
  (~sinosc5 ~sinosc)
  (~envgen6 (~envgen #:segs ((0.3 0.005) (0 0.8 -4)) #:release 1))
  (~mul7 ~mul)
  (outlet8 (outlet "signal" "the voice"))
  (comment9 (comment "# voice\n`mtof` turns each note into a pitch for `~dc`.\nthe envelope holds while the gate is open, and\nfalls when it closes. `~dc` starts at 0 hz, so\nthe voice is silent until its first note." 420 95))
  (-> inlet0 fnref2)
  (-> inlet0 (ref3 1))
  (-> fnref2 ref3)
  (-> ref3 ~dc4)
  (-> ~dc4 ~sinosc5)
  (-> inlet1 ~envgen6)
  (-> ~sinosc5 ~mul7)
  (-> ~envgen6 (~mul7 1))
  (-> ~mul7 outlet8))

