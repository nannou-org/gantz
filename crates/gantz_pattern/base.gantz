(graph demo.pat.voices:bell
  (inlet0 (inlet "schedule" "(seconds note) pairs"))
  (fnref1 (fn-ref mtof #:sync))
  (ref2 (ref sched.map #:sync))
  (ref3 (ref demo.pat.voices:bell:trig #:sync))
  (~dc4 ~dc)
  (~sinosc5 ~sinosc)
  (~envgen6 (~envgen #:segs ((0.3 0.005) (0 1.5 -4))))
  (~mul7 ~mul)
  (outlet8 (outlet "signal" "the bell"))
  (comment9 (comment "# bell\n`mtof` turns each note into a pitch, and `trig`\nstarts the envelope. `~dc` holds the pitch. it\nstarts at 0 hz, so the bell is silent until its\nfirst event." 420 95))
  (-> inlet0 fnref1)
  (-> inlet0 (ref2 1))
  (-> inlet0 ref3)
  (-> fnref1 ref2)
  (-> ref2 ~dc4)
  (-> ~dc4 ~sinosc5)
  (-> ref3 ~envgen6)
  (-> ~sinosc5 ~mul7)
  (-> ~envgen6 (~mul7 1))
  (-> ~mul7 outlet8))

(graph demo.pat.voices:bell:trig
  (inlet0 (inlet "schedule" "(seconds value) pairs"))
  (expr1 (expr (transduce $pairs
  (flat-mapping
    (lambda (p)
      (list (list (car p) 1.0)
            (list (+ (car p) 0.01) 0.0))))
  (into-list))))
  (outlet2 (outlet "schedule" "(seconds gate) pairs"))
  (comment3 (comment "# trig\neach event opens the gate, and 10 ms later it\ncloses again - used to create a \"rising edge\" for an `~envgen`" 362 68))
  (-> inlet0 expr1)
  (-> expr1 outlet2))

