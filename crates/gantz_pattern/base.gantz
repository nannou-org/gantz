  (ref5 (ref pat.sched #:sync))
  (~sinosc6 ~sinosc)
  (~out7 ~out)
  (pat.plot8 (pat.plot #:end 3 #:width 240))
  (comment9 (comment "# cps\na demo of patterning \"cycles-per-second\" alongside a melodic pattern." 328 51))
  (comment10 (comment "a simple melodic pattern" 214 17))
  (comment11 (comment "a cps pattern starting with 0.5hz for the first cycle, then 1hz for the next, then 2hz for the last" 266 51))
  (-> tick-bang0 pat.mini1)
  (-> tick-bang0 pat.mini2)
  (-> tick-bang0 ref3)
  (-> pat.mini1 (ref3 1))
  (-> pat.mini1 pat.plot8)
  (-> pat.mini2 ref4)
  (-> ref3 (ref4 1))
  (-> ref4 ref5)
  (-> (ref3 1) (ref5 1))
  (-> (ref3 2) (ref5 2))
  (-> ref5 ~sinosc6)
  (-> ~sinosc6 ~out7))

(graph demo.pat.maps
  (tick-bang0 (tick-bang #:rate 60))
  (pat.mini1 (pat.mini "220 [330 440] <550 660>"))
  (pat.key2 (pat.key "freq"))
  (pat.mini3 (pat.mini "1 1/4 1/2"))
  (pat.key4 (pat.key "amp"))
  (pat.mini5 (pat.mini "<1/2 1>"))
  (pat.key6 (pat.key "cps"))
  (ref7 (ref pat.with #:sync))
  (ref8 (ref pat.with #:sync))
  (expr9 (expr (pat/map (lambda (m) (hash-ref m 'cps)) $p) #:require "gantz/pattern"))
  (ref10 (ref pat.window #:sync))
  (ref11 (ref pat.query #:sync))
  (ref12 (ref pat.sched #:sync))
  (sched.pick13 (sched.pick "freq"))
  (sched.pick14 (sched.pick "amp"))
  (~sinosc15 ~sinosc)
  (~mul16 (~mul #:b-lag 0.05))
  (~out17 ~out)
  (pat.plot18 (pat.plot #:end 2 #:width 240))
  (comment19 (comment "# patterns of maps\nmany patterns can be combined into one using maps, storing different values behind different keys." 275 68))
  (comment20 (comment "the cps of each map drives the clock" 160 34))
  (comment21 (comment "a visualisation of two cycles of the combined pattern using `pat.plot`" 242 51))
  (-> tick-bang0 pat.mini1)
  (-> tick-bang0 pat.mini3)
  (-> tick-bang0 pat.mini5)
  (-> tick-bang0 ref10)
  (-> pat.mini1 pat.key2)
  (-> pat.mini3 pat.key4)
  (-> pat.mini5 pat.key6)
  (-> pat.key2 ref7)
  (-> pat.key4 (ref7 1))
  (-> ref7 ref8)
  (-> pat.key6 (ref8 1))
  (-> ref8 expr9)
  (-> ref8 ref11)
  (-> ref8 pat.plot18)
  (-> expr9 (ref10 1))
  (-> ref10 (ref11 1))
  (-> ref11 ref12)
  (-> (ref10 1) (ref12 1))
  (-> (ref10 2) (ref12 2))
  (-> ref12 sched.pick13)
  (-> ref12 sched.pick14)
  (-> sched.pick13 ~sinosc15)
  (-> ~sinosc15 ~mul16)
  (-> sched.pick14 (~mul16 1))
  (-> ~mul16 ~out17))

(graph demo.pat.plot
  (load-bang0 load-bang)
  (pat.mini1 (pat.mini "0 [1 2] <3 5>"))
  (pat.plot2 (pat.plot #:end 2 #:width 240))
  (pat.mini3 (pat.mini "bd [sn hh] <cp ~>"))
  (pat.plot4 (pat.plot #:end 2 #:width 240))
  (pat.mini5 (pat.mini "[bd*2, hh*4]"))
  (pat.plot6 (pat.plot #:width 240))
  (comment7 (comment "a continuous signal" 240 19))
  (comment8 (comment "lists of strings" 240 19))
  (ref9 (ref pat.saw #:sync))
  (pat.plot10 (pat.plot #:fit 2 #:width 240))
  (expr11 (expr (pat/map (lambda (n) (hash 's (if (> n 2) 'sn 'bd) 'n n)) $p) #:require "gantz/pattern"))
  (pat.plot12 (node "Pplot" (color null) (end #(2 1)) (height 80) (interactive #f) (key_colors #(((color #(0 22 255 255)) (key "s")) ((color #(255 0 0 255)) (key "n")))) (layout "Stack") (margin #t) (res ((Fixed 128))) (show_axes #f) (show_grid #f) (start #(0 1)) (width 240) (y_max null) (y_min null)))
  (pat.plot13 (pat.plot #:end 2 #:expand #:width 240 #:height 120))
  (expr14 (expr (pat/map (lambda (n) (list n (* n 2))) $p) #:require "gantz/pattern"))
  (pat.plot15 (pat.plot #:end 2 #:expand #:width 240 #:height 120))
  (expr16 (expr (pat/map (lambda (n) (lambda () n)) $p) #:require "gantz/pattern"))
  (pat.plot17 (pat.plot #:width 240))
  (load-bang18 load-bang)
  (comment19 (comment "numbers" 240 19))
  (comment20 (comment "lists of numbers" 240 19))
  (comment21 (comment "maps from strings to values, such as n: 5, s: \"bd\". one plot per key, or every key on one plot." 420 38))
  (comment22 (comment "keys stacked on one plot, each in the colour that the inspector sets" 240 38))
  (comment23 (comment "a separate plot for each key" 240 19))
  (comment24 (comment "values of an unknown type show only their spans" 240 38))
  (pat.mini25 (pat.mini "0 [1 2] <3 5>"))
  (load-bang26 load-bang)
  (pat.mini27 (pat.mini "0 [1 2] <3 5>"))
  (comment28 (comment "# plotting patterns\n`pat.plot` shows the events of a\npattern over a span of cycles." 300 57))
  (pat.mini29 (pat.mini "0 [1 2] <3 5>"))
  (load-bang30 load-bang)
  (load-bang31 load-bang)
  (comment32 (comment "strings" 240 19))
  (load-bang33 load-bang)
  (load-bang34 load-bang)
  (-> expr16 pat.plot17)
  (-> pat.mini29 expr11)
  (-> load-bang33 ref9)
  (-> load-bang31 pat.mini3)
  (-> load-bang0 pat.mini1)
  (-> pat.mini25 pat.plot2)
  (-> pat.mini3 pat.plot4)
  (-> pat.mini5 pat.plot6)
  (-> pat.mini27 expr14)
  (-> ref9 pat.plot10)
  (-> load-bang18 pat.mini5)
  (-> expr11 pat.plot12)
  (-> expr11 pat.plot13)
  (-> load-bang26 pat.mini25)
  (-> expr14 pat.plot15)
  (-> pat.mini1 expr16)
  (-> load-bang30 pat.mini29)
  (-> load-bang34 pat.mini27))

(graph demo.pat.targets
  (tick-bang0 (tick-bang #:rate 60))
  (number1 (number #:min 0.25 #:max 2 #:init 0.5 #:label "cps" #:input bang #:no-push-eval))
  (pat.mini2 (pat.mini "60 [63 65] <67 72>"))
  (pat.key3 (pat.key "note"))
  (pat.mini4 (pat.mini "1 1/2 3/4"))
  (pat.key5 (pat.key "level"))
  (ref6 (ref pat.with #:sync))
  (ref7 (ref pat.window #:sync))
  (ref8 (ref pat.query #:sync))
  (ref9 (ref pat.sched #:sync))
  (fnref10 (fn-ref demo.pat.targets:sound #:sync))
  (ref11 (ref sched.map #:sync))
  (sched.pick12 (sched.pick "freq"))
  (sched.pick13 (sched.pick "amp"))
  (~sinosc14 ~sinosc)
  (~mul15 (~mul #:b-lag 0.05))
  (~out16 ~out)
  (expr17 (expr (pat/span-start $span) #:require "gantz/pattern"))
  (number18 (number #:min -0.5 #:max 0.5 #:init -0.05 #:label "nudge" #:input bang #:no-push-eval))
  (ref19 (ref pat.nudge #:sync))
  (ref20 (ref pat.at #:sync))
  (fnref21 (fn-ref demo.pat.targets:screen #:sync))
  (expr22 (expr (transduce $events (mapping $f) (into-list))))
  (ref23 (ref demo.pat.targets:canvas #:sync))
  (comment24 (comment "# pattern targets\npatterns can be used to drive multiple targets.\nbelow, the same pattern is used to 1. play a sine wave and 2. draw to a small UI canvas." 420 68))
  (comment25 (comment "the events from the pattern that are active right now" 237 34))
  (comment26 (comment "the events from the pattern that start within the current `tick`" 262 34))
  (-> tick-bang0 pat.mini2)
  (-> tick-bang0 pat.mini4)
  (-> tick-bang0 ref7)
  (-> tick-bang0 number1)
  (-> tick-bang0 number18)
  (-> number1 (ref7 1))
  (-> number1 (ref19 2))
  (-> pat.mini2 pat.key3)
  (-> pat.mini4 pat.key5)
  (-> pat.key3 ref6)
  (-> pat.key5 (ref6 1))
  (-> ref6 ref8)
  (-> ref6 ref20)
  (-> ref7 (ref8 1))
  (-> ref7 expr17)
  (-> (ref7 1) (ref9 1))
  (-> (ref7 2) (ref9 2))
  (-> (ref7 3) (ref19 3))
  (-> ref8 ref9)
  (-> ref9 fnref10)
  (-> ref9 (ref11 1))
  (-> fnref10 ref11)
  (-> ref11 sched.pick12)
  (-> ref11 sched.pick13)
  (-> sched.pick12 ~sinosc14)
  (-> ~sinosc14 ~mul15)
  (-> sched.pick13 (~mul15 1))
  (-> ~mul15 ~out16)
  (-> expr17 ref19)
  (-> number18 (ref19 1))
  (-> ref19 (ref20 1))
  (-> ref20 fnref21)
  (-> ref20 expr22)
  (-> fnref21 (expr22 1))
  (-> expr22 ref23))

(graph demo.pat.targets:canvas
  (inlet0 (inlet "list" "the figures to draw"))
  (expr1 (expr (set! state (list (append '(panel (@ (x 0 1) (y 0 1))) $figures)))))
  (bind2 (bind 1))
  (expr3 (expr 280))
  (expr4 (expr 120))
  (ref5 (ref ui.canvas #:sync))
  (gui6 gui)
  (comment7 (comment "# canvas\nthe last step of a column, and the only one that\nknows the screen. it keeps one panel in its state." 420 57))
  (-> inlet0 expr1)
  (-> bind2 ref5)
  (-> expr3 (ref5 4))
  (-> expr4 (ref5 5))
  (-> ref5 gui6))

(graph demo.pat.targets:screen
  (inlet0 (inlet "event" "an event alive at the playhead"))
  (expr1 (expr (pat/event-value $e) #:require "gantz/pattern"))
  (expr2 (expr (pat/event-phase $e) #:require "gantz/pattern"))
  (expr3 (expr (hash-ref $m 'note)))
  (expr4 (expr (hash-ref $m 'level)))
  (expr5 (expr (/ (- $note 60) 13.0)))
  (expr6 (expr (* $level (- 1.0 $phase))))
  (expr7 (expr (list 'rect $x 0.0 (+ $x 0.06) $y)))
  (outlet8 (outlet "figure" "a bar that falls over the life of the event"))
  (comment9 (comment "# screen\nnote picks the place of a bar. level sets its\nheight, which falls over the life of the event." 400 57))
  (-> inlet0 expr1)
  (-> inlet0 expr2)
  (-> expr1 expr3)
  (-> expr1 expr4)
  (-> expr3 expr5)
  (-> expr4 expr6)
  (-> expr2 (expr6 1))
  (-> expr5 expr7)
  (-> expr6 (expr7 1))
  (-> expr7 outlet8))

(graph demo.pat.targets:sound
  (inlet0 (inlet "map" "the value of an event"))
  (expr1 (expr (hash-ref $m 'note)))
  (expr2 (expr (hash-ref $m 'level)))
  (ref3 (ref mtof #:sync))
  (expr4 (expr (* $level $level)))
  (expr5 (expr (hash-insert (hash-insert $m 'freq $f) 'amp $a)))
  (outlet6 (outlet "map" "the event with the keys of the sound"))
  (comment7 (comment "# sound\nconverts an incoming map's `note` values to `freq`uencies, and `level` to `amp`litude." 400 51))
  (-> inlet0 expr1)
  (-> inlet0 expr2)
  (-> inlet0 expr5)
  (-> expr1 ref3)
  (-> expr2 expr4)
  (-> ref3 (expr5 1))
  (-> expr4 (expr5 2))
  (-> expr5 outlet6))

