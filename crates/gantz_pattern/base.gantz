(graph demo.pat
  (tick-bang0 (tick-bang #:rate 60))
  (number1 (number #:min 0.5 #:label "cps" #:input bang))
  (pat.mini2 (pat.mini "220 [330 440] <550 660>"))
  (ref3 (ref pat.window #:sync))
  (ref4 (ref pat.query #:sync))
  (ref5 (ref pat.sched #:sync))
  (~sinosc6 ~sinosc)
  (~out7 ~out)
  (pat.plot8 (pat.plot #:end 2 #:width 240))
  (comment9 (comment "# pattern\na mini-notation pattern plays a\nsine. edit the string and dial cps." 300 57))
  (-> tick-bang0 number1)
  (-> tick-bang0 pat.mini2)
  (-> tick-bang0 ref3)
  (-> number1 (ref3 1))
  (-> pat.mini2 ref4)
  (-> pat.mini2 pat.plot8)
  (-> ref3 (ref4 1))
  (-> ref4 ref5)
  (-> (ref3 1) (ref5 1))
  (-> (ref3 2) (ref5 2))
  (-> ref5 ~sinosc6)
  (-> ~sinosc6 ~out7))

