(graph demo.pat
  (tick-bang0 (tick-bang #:rate 60))
  (number1 (number #:min 0.5 #:label "cps"))
  (pat.mini2 (pat.mini "220 [330 440] <550 660>"))
  (ref3 (ref pat.window #:sync))
  (ref4 (ref pat.query #:sync))
  (ref5 (ref pat.sched #:sync))
  (~sinosc6 ~sinosc)
  (~out7 ~out)
  (bang8 bang)
  (pat.plot9 (pat.plot #:end 2 #:width 240))
  (comment10 (comment "# pattern\na mini-notation pattern plays a\nsine. edit the string and dial cps." 300 57))
  (-> tick-bang0 bang8)
  (-> bang8 number1)
  (-> tick-bang0 pat.mini2)
  (-> tick-bang0 ref3)
  (-> number1 (ref3 1))
  (-> number1 (ref5 2))
  (-> pat.mini2 ref4)
  (-> pat.mini2 pat.plot9)
  (-> ref3 (ref4 1))
  (-> ref4 ref5)
  (-> ref3 (ref5 1))
  (-> ref5 ~sinosc6)
  (-> ~sinosc6 ~out7))

(graph demo.pat.plot
  (load-bang0 load-bang)
  (pat.mini1 (pat.mini "0 [1 2] <3 5>"))
  (pat.plot2 (pat.plot #:end 2 #:width 240))
  (pat.mini3 (pat.mini "bd [sn hh] <cp ~>"))
  (pat.plot4 (pat.plot #:end 2 #:width 240))
  (pat.mini5 (pat.mini "[bd*2, hh*4]"))
  (pat.plot6 (pat.plot #:width 240))
  (comment7 (comment "a continuous signal" 240 19))
  (comment8 (comment "lists of strings" 240 19))
  (ref9 (ref pat.saw #:sync))
  (pat.plot10 (pat.plot #:fit 2 #:width 240))
  (expr11 (expr (pat/map (lambda (n) (hash 's (if (> n 2) 'sn 'bd) 'n n)) $p) #:require "gantz/pattern"))
  (pat.plot12 (node "Pplot" (color null) (end #(2 1)) (height 80) (interactive #f) (key_colors #(((color #(0 22 255 255)) (key "s")) ((color #(255 0 0 255)) (key "n")))) (layout "Stack") (margin #t) (res ((Fixed 128))) (show_axes #f) (show_grid #f) (start #(0 1)) (width 240) (y_max null) (y_min null)))
  (pat.plot13 (pat.plot #:end 2 #:expand #:width 240 #:height 120))
  (expr14 (expr (pat/map (lambda (n) (list n (* n 2))) $p) #:require "gantz/pattern"))
  (pat.plot15 (pat.plot #:end 2 #:expand #:width 240 #:height 120))
  (expr16 (expr (pat/map (lambda (n) (lambda () n)) $p) #:require "gantz/pattern"))
  (pat.plot17 (pat.plot #:width 240))
  (load-bang18 load-bang)
  (comment19 (comment "numbers" 240 19))
  (comment20 (comment "lists of numbers" 240 19))
  (comment21 (comment "maps from strings to values, such as n: 5, s: \"bd\". one plot per key, or every key on one plot." 420 38))
  (comment22 (comment "keys stacked on one plot, each in the colour that the inspector sets" 240 38))
  (comment23 (comment "a separate plot for each key" 240 19))
  (comment24 (comment "values of an unknown type show only their spans" 240 38))
  (pat.mini25 (pat.mini "0 [1 2] <3 5>"))
  (load-bang26 load-bang)
  (pat.mini27 (pat.mini "0 [1 2] <3 5>"))
  (comment28 (comment "# plotting patterns\n`pat.plot` shows the events of a\npattern over a span of cycles." 300 57))
  (pat.mini29 (pat.mini "0 [1 2] <3 5>"))
  (load-bang30 load-bang)
  (load-bang31 load-bang)
  (comment32 (comment "strings" 240 19))
  (load-bang33 load-bang)
  (load-bang34 load-bang)
  (-> expr16 pat.plot17)
  (-> pat.mini29 expr11)
  (-> load-bang33 ref9)
  (-> load-bang31 pat.mini3)
  (-> load-bang0 pat.mini1)
  (-> pat.mini25 pat.plot2)
  (-> pat.mini3 pat.plot4)
  (-> pat.mini5 pat.plot6)
  (-> pat.mini27 expr14)
  (-> ref9 pat.plot10)
  (-> load-bang18 pat.mini5)
  (-> expr11 pat.plot12)
  (-> expr11 pat.plot13)
  (-> load-bang26 pat.mini25)
  (-> expr14 pat.plot15)
  (-> pat.mini1 expr16)
  (-> load-bang30 pat.mini29)
  (-> load-bang34 pat.mini27))

(graph pat.app
  (expr0 (expr (pat/app $pv $pf) #:require "gantz/pattern"))
  (inlet1 (inlet "pattern" "pattern of values"))
  (inlet2 (inlet "pattern" "pattern of functions"))
  (outlet3 (outlet "pattern" "functions applied at intersections"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.degradeby
  (expr0 (expr (pat/degrade-by $seed $prob $p) #:require "gantz/pattern"))
  (inlet1 (inlet "seed" "seed for the drops"))
  (inlet2 (inlet "number" "probability of a drop"))
  (inlet3 (inlet "pattern" "input pattern"))
  (outlet4 (outlet "pattern" "the events that are not dropped"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> expr0 outlet4))

(graph pat.euclid
  (expr0 (expr (pat/euclid (exact (round $k)) (exact (round $n))) #:require "gantz/pattern"))
  (inlet1 (inlet "number" "onset count"))
  (inlet2 (inlet "number" "slot count"))
  (outlet3 (outlet "pattern" "one event per onset slot"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.euclidfull
  (expr0 (expr (pat/euclid-full (exact (round $k)) (exact (round $n))) #:require "gantz/pattern"))
  (inlet1 (inlet "number" "onset count"))
  (inlet2 (inlet "number" "slot count"))
  (outlet3 (outlet "pattern" "onsets elongated to the next onset"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.euclidoff
  (expr0 (expr (pat/euclid-off (exact (round $k)) (exact (round $n)) (exact (round $off))) #:require "gantz/pattern"))
  (inlet1 (inlet "number" "onset count"))
  (inlet2 (inlet "number" "slot count"))
  (inlet3 (inlet "number" "rotation in slots"))
  (outlet4 (outlet "pattern" "one event per rotated onset slot"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> expr0 outlet4))

(graph pat.fast
  (expr0 (expr (pat/fast (pat/rationalize $rate) $p) #:require "gantz/pattern"))
  (inlet1 (inlet "number" "speed factor"))
  (inlet2 (inlet "pattern" "input pattern"))
  (outlet3 (outlet "pattern" "sped-up pattern"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.fastcat
  (expr0 (expr (pat/fastcat (if (list? $ps) $ps (list $ps))) #:require "gantz/pattern"))
  (inlet1 (inlet "pattern(s)" "patterns in connection order"))
  (outlet2 (outlet "pattern" "all patterns within one cycle"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.filter
  (expr0 (expr (pat/filter $f $p) #:require "gantz/pattern"))
  (inlet1 (inlet "function" "value predicate"))
  (inlet2 (inlet "pattern" "input pattern"))
  (outlet3 (outlet "pattern" "events whose values satisfy the predicate"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.indices
  (expr0 (expr (begin $b pat/indices) #:require "gantz/pattern"))
  (inlet1 (inlet "bang" "trigger"))
  (outlet2 (outlet "pattern" "each cycle's index once per cycle"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.join
  (expr0 (expr (pat/join $pp) #:require "gantz/pattern"))
  (inlet1 (inlet "pattern" "pattern of patterns"))
  (outlet2 (outlet "pattern" "inner events within their outer events"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.map
  (expr0 (expr (pat/map $f $p) #:require "gantz/pattern"))
  (inlet1 (inlet "function" "value mapping"))
  (inlet2 (inlet "pattern" "input pattern"))
  (outlet3 (outlet "pattern" "pattern of mapped values"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.mapevents
  (expr0 (expr (pat/map-events $f $p) #:require "gantz/pattern"))
  (inlet1 (inlet "function" "event mapping"))
  (inlet2 (inlet "pattern" "input pattern"))
  (outlet3 (outlet "pattern" "pattern of mapped events"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.mergewith
  (expr0 (expr (pat/merge-with $f $pa $pb) #:require "gantz/pattern"))
  (inlet1 (inlet "function" "combines a value from each pattern"))
  (inlet2 (inlet "pattern" "first pattern"))
  (inlet3 (inlet "pattern" "second pattern"))
  (outlet4 (outlet "pattern" "combined values where events meet"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> expr0 outlet4))

(graph pat.pure
  (expr0 (expr (pat/pure $v) #:require "gantz/pattern"))
  (inlet1 (inlet "value" "event value"))
  (outlet2 (outlet "pattern" "one event per cycle"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.query
  (expr0 (expr (pat/query $p $span) #:require "gantz/pattern"))
  (inlet1 (inlet "pattern" "pattern to query"))
  (inlet2 (inlet "span" "span to query over"))
  (outlet3 (outlet "events" "events sorted by active start"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.rand
  (expr0 (expr (pat/rand $seed) #:require "gantz/pattern"))
  (inlet1 (inlet "seed" "seed for the values"))
  (outlet2 (outlet "pattern" "random floats in [0, 1)"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.saw
  (expr0 (expr (begin $b pat/saw) #:require "gantz/pattern"))
  (inlet1 (inlet "bang" "trigger"))
  (outlet2 (outlet "pattern" "0 to 1 ramp each cycle"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.sched
  (expr0 (expr (pat/events->secs $events $span (hash-ref %args 'time) $cps) #:require "gantz/pattern"))
  (inlet1 (inlet "events" "queried window events"))
  (inlet2 (inlet "span" "the queried window"))
  (inlet3 (inlet "number" "tempo in cycles per second"))
  (outlet4 (outlet "list" "(seconds value) onset pairs"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> expr0 outlet4))

(graph pat.shift
  (expr0 (expr (pat/shift (pat/rationalize $amount) $p) #:require "gantz/pattern"))
  (inlet1 (inlet "number" "cycles to shift later"))
  (inlet2 (inlet "pattern" "input pattern"))
  (outlet3 (outlet "pattern" "shifted pattern"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.silence
  (expr0 (expr (begin $b pat/silence) #:require "gantz/pattern"))
  (inlet1 (inlet "bang" "trigger"))
  (outlet2 (outlet "pattern" "no events"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.slow
  (expr0 (expr (pat/slow (pat/rationalize $rate) $p) #:require "gantz/pattern"))
  (inlet1 (inlet "number" "slow-down factor"))
  (inlet2 (inlet "pattern" "input pattern"))
  (outlet3 (outlet "pattern" "slowed pattern"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.slowcat
  (expr0 (expr (pat/slowcat (if (list? $ps) $ps (list $ps))) #:require "gantz/pattern"))
  (inlet1 (inlet "pattern(s)" "patterns in connection order"))
  (outlet2 (outlet "pattern" "one pattern per cycle"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.stack
  (expr0 (expr (pat/stack (if (list? $ps) $ps (list $ps))) #:require "gantz/pattern"))
  (inlet1 (inlet "pattern(s)" "patterns in connection order"))
  (outlet2 (outlet "pattern" "layered patterns"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.steady
  (expr0 (expr (pat/steady $v) #:require "gantz/pattern"))
  (inlet1 (inlet "value" "constant value"))
  (outlet2 (outlet "pattern" "continuous constant signal"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.timecat
  (expr0 (expr (pat/timecat (list/zip (list/map pat/rationalize (if (list? $ws) $ws (list $ws))) (if (list? $ps) $ps (list $ps)))) #:require "gantz/list" #:require "gantz/pattern"))
  (inlet1 (inlet "number(s)" "weights in connection order"))
  (inlet2 (inlet "pattern(s)" "patterns in connection order"))
  (outlet3 (outlet "pattern" "patterns sharing each cycle by weight"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.window
  (expr0 (expr (begin $tick (let ((r (pat/window state (hash-ref %args 'time) $cps))) (begin (set! state (list-ref r 1)) (list-ref r 0)))) #:require "gantz/pattern"))
  (inlet1 (inlet "bang" "tick trigger"))
  (inlet2 (inlet "number" "tempo in cycles per second"))
  (outlet3 (outlet "span" "the window since the previous tick"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(descriptions
  (demo.pat "A mini-notation frequency pattern queried per tick plays a sine and plots two cycles. Edit the string and dial the cps.")
  (demo.pat.plot "Every kind of event value in `pat.plot` nodes. Numbers, symbols, overlapping symbols, bools, a signal, maps stacked and expanded, lists and opaque values.")
  (pat.app "Apply a pattern of functions to a pattern of values.")
  (pat.degradeby "Drop events at random with a given probability.")
  (pat.euclid "K onsets distributed over N slots per cycle.")
  (pat.euclidfull "Euclidean onsets elongated to fill the gaps.")
  (pat.euclidoff "Euclidean onsets rotated left by an offset.")
  (pat.fast "Speed a pattern up by a factor.")
  (pat.fastcat "Concatenate patterns within a single cycle.")
  (pat.filter "Keep events whose values satisfy a predicate.")
  (pat.indices "Each cycle's index, once per cycle.")
  (pat.join "Flatten a pattern of patterns, keeping both structures.")
  (pat.map "Map a function over a pattern's values.")
  (pat.mapevents "Map a function over a pattern's events, spans included.")
  (pat.mergewith "Combine the values of two patterns with a function where their events meet.")
  (pat.pure "Repeat a value once per cycle.")
  (pat.query "Query a pattern over a span for its sorted events.")
  (pat.rand "A seeded signal of random floats in [0, 1).")
  (pat.saw "A 0 to 1 ramp signal each cycle.")
  (pat.sched "Window events as (seconds value) onset pairs for delivery.")
  (pat.shift "Shift a pattern later in time.")
  (pat.silence "The empty pattern.")
  (pat.slow "Slow a pattern down by a factor.")
  (pat.slowcat "Concatenate patterns, one per cycle.")
  (pat.stack "Layer patterns on top of each other.")
  (pat.steady "A continuous constant signal.")
  (pat.timecat "Concatenate patterns within a single cycle, each taking a share by its weight.")
  (pat.window "Advance a tick-driven query window in cycles."))

(layout demo.pat
  (bang8 700 160)
  (comment10 0 0)
  (number1 700 220)
  (pat.mini2 280 160)
  (pat.plot9 0 240)
  (ref3 560 280)
  (ref4 280 340)
  (ref5 280 460)
  (tick-bang0 560 100)
  (~out7 280 580)
  (~sinosc6 280 520)
  (camera 420 300 1))

