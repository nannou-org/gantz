  (-> expr0 outlet2))

(graph pat.spanstart
  (expr0 (expr (pat/span-start $s) #:require "gantz/pattern"))
  (inlet1 (inlet "span" "a span"))
  (outlet2 (outlet "number" "start in cycles"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.stack
  (expr0 (expr (pat/stack (if (list? $ps) $ps (list $ps))) #:require "gantz/pattern"))
  (inlet1 (inlet "pattern(s)" "patterns in connection order"))
  (outlet2 (outlet "pattern" "layered patterns"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.steady
  (expr0 (expr (pat/steady $v) #:require "gantz/pattern"))
  (inlet1 (inlet "value" "constant value"))
  (outlet2 (outlet "pattern" "continuous constant signal"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph pat.timecat
  (expr0 (expr (pat/timecat (list/zip (list/map pat/rationalize (if (list? $ws) $ws (list $ws))) (if (list? $ps) $ps (list $ps)))) #:require "gantz/list" #:require "gantz/pattern"))
  (inlet1 (inlet "number(s)" "weights in connection order"))
  (inlet2 (inlet "pattern(s)" "patterns in connection order"))
  (outlet3 (outlet "pattern" "patterns sharing each cycle by weight"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.window
  (expr0 (expr (let ((r (pat/window state (hash-ref %args 'time) $tick $cps))) (begin (set! state (list-ref r 4)) r)) #:require "gantz/pattern"))
  (inlet1 (inlet "tick" "tick duration in seconds"))
  (inlet2 (inlet "cps" "a number or a pattern of numbers"))
  (expr3 (expr (list-ref $window 0)))
  (expr4 (expr (list-ref $window 1)))
  (expr5 (expr (list-ref $window 2)))
  (expr6 (expr (list-ref $window 3)))
  (outlet7 (outlet "span" "the cycles of this tick"))
  (outlet8 (outlet "number" "seconds at the start of the span"))
  (outlet9 (outlet "segments" "the (start end cps) segments of the span"))
  (outlet10 (outlet "number" "cps at the start of the span"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 expr3)
  (-> expr0 expr4)
  (-> expr0 expr5)
  (-> expr0 expr6)
  (-> expr3 outlet7)
  (-> expr4 outlet8)
  (-> expr5 outlet9)
  (-> expr6 outlet10))

(graph pat.with
  (expr0 (expr (pat/with $pa $pb) #:require "gantz/pattern"))
  (inlet1 (inlet "pattern" "structure and maps"))
  (inlet2 (inlet "pattern" "values to add"))
  (outlet3 (outlet "pattern" "the first pattern with the values of both"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph sched.filter
  (expr0 (expr (sched/filter $f $schedule) #:require "gantz/sched"))
  (inlet1 (inlet "function" "value predicate"))
  (inlet2 (inlet "schedule" "(seconds value) pairs"))
  (outlet3 (outlet "schedule" "the pairs whose values satisfy the predicate"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph sched.map
  (expr0 (expr (sched/map $f $schedule) #:require "gantz/sched"))
  (inlet1 (inlet "function" "value mapping"))
  (inlet2 (inlet "schedule" "(seconds value) pairs"))
  (outlet3 (outlet "schedule" "(seconds value) pairs of mapped values"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph sched.trig
  (expr0 (expr (sched/trig $schedule $len) #:require "gantz/sched"))
  (inlet1 (inlet "schedule" "(seconds value) pairs"))
  (inlet2 (inlet "number" "pulse length in seconds"))
  (outlet3 (outlet "schedule" "(seconds gate) pairs, 1.0 to open and 0.0 to close"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(descriptions
  (demo.pat "A mini-notation frequency pattern queried per tick plays a sine and plots two cycles. Edit the string and dial the cps.")
  (demo.pat.cps "A second pattern sets the cps, which steps each cycle without a jump in position. Edit either string.")
  (demo.pat.maps "Patterns join into one map per event. `pat.get` reads the cps of each map for the clock, and `sched.pick` routes each key to a control.")
  (demo.pat.plot "Every kind of event value in `pat.plot` nodes. Numbers, symbols, overlapping symbols, bools, a signal, maps stacked and expanded, lists and opaque values.")
  (demo.pat.targets "One pattern plays a sine and draws on a canvas. `pat.sched` gives the onsets of each tick to the sound, and `pat.at` gives the events alive at the playhead to the canvas. Edit the strings and dial the cps.")
  (demo.pat.targets:canvas "Draws the figures that `demo.pat.targets` gives on a canvas, in its node.")
  (demo.pat.targets:screen "Turns an event of `demo.pat.targets` into a bar for the canvas.")
  (demo.pat.targets:sound "Turns the keys of an event value of `demo.pat.targets` into the keys of the sound.")
  (demo.pat.voices "Three patterns each play a bell, and the bells sum into one reverb. Edit the strings and dial the cps.")
  (demo.pat.voices:bell "A bell for `demo.pat.voices`. Each note sets the pitch and starts the envelope.")
  (demo.sched "A pattern of maps plays a bass and a bell. `sched.split` routes each note by its voice key, `sched.gate` holds each bass note for its length, and `sched.filter` and `sched.trig` play the bell. Dial the cps, the lowest bell note and the pulse length.")
  (demo.sched:voice "A sine voice for `demo.sched`. Each note sets the pitch, and the gate holds the envelope open.")
  (pat.app "Apply a pattern of functions to a pattern of values.")
  (pat.appl "Apply a pattern of functions to a pattern of values, with the structure of the values.")
  (pat.appr "Apply a pattern of functions to a pattern of values, with the structure of the functions.")
  (pat.at "The events of a pattern that are alive at a cycle point. `pat.eventphase` gives how far the point is through each of them.")
  (pat.cache "Keep the events of each cycle of a pattern after its first query. A later query of the cycle reads the kept events of the slices it overlaps. The kept events live as long as the pattern does. Build the pattern only when its inputs change. A pattern built again on each eval fills its cache again each time.")
  (pat.degradeby "Drop events at random with a given probability.")
  (pat.euclid "K onsets distributed over N slots per cycle.")
  (pat.euclidfull "Euclidean onsets elongated to fill the gaps.")
  (pat.euclidoff "Euclidean onsets rotated left by an offset.")
  (pat.event "Make an event from its value, its active span and its whole span.")
  (pat.eventactive "The active span of an event, where its value applies within a query.")
  (pat.eventphase "How far the active start of an event is through its whole, from 0 to 1. A signal has no whole, so it gives #f.")
  (pat.eventvalue "The value of an event.")
  (pat.eventwhole "The whole span of an event, which a signal does not have.")
  (pat.fast "Speed a pattern up by a factor.")
  (pat.fastcat "Concatenate patterns within a single cycle.")
  (pat.filter "Keep events whose values satisfy a predicate.")
  (pat.filterevents "Keep events that satisfy a predicate of the event.")
  (pat.fitcycle "Fit one cycle of a pattern into a span.")
  (pat.fitspan "Fit one span of a pattern into another span.")
  (pat.indices "Each cycle's index, once per cycle.")
  (pat.innerjoin "Flatten a pattern of patterns, with the structure of the inner patterns.")
  (pat.join "Flatten a pattern of patterns, keeping both structures.")
  (pat.map "Map a function over a pattern's values.")
  (pat.mapevents "Map a function over a pattern's events, spans included.")
  (pat.maplen "Give each event the length that a function returns for its length in cycles. The starts stay.")
  (pat.mergewith "Combine the values of two patterns with a function where their events meet.")
  (pat.mergewithl "Combine the values of two patterns with a function where their events meet, with the structure of the first.")
  (pat.mergewithr "Combine the values of two patterns with a function where their events meet, with the structure of the second.")
  (pat.nudge "Move a cycle point by a number of seconds at a steady or patterned cps, for a target with its own latency. A cps change between the two points counts.")
  (pat.outerjoin "Flatten a pattern of patterns, with the structure of the outer pattern.")
  (pat.pure "Repeat a value once per cycle.")
  (pat.query "Query a pattern over a span for its sorted events.")
  (pat.rand "A seeded signal of random floats in [0, 1).")
  (pat.saw "A 0 to 1 ramp signal each cycle.")
  (pat.scalelen "Multiply the length of each event by a factor, a number or a pattern of numbers. The starts stay.")
  (pat.sched "The onsets among queried window events, as a schedule of (seconds value) pairs. The seconds and segments of the window time them.")
  (pat.secs "The seconds between two cycle points at a steady or patterned cps, the inverse of `pat.nudge`.")
  (pat.segment "Sample a pattern into a number of events per cycle.")
  (pat.shift "Shift a pattern later in time.")
  (pat.silence "The empty pattern.")
  (pat.slow "Slow a pattern down by a factor.")
  (pat.slowcat "Concatenate patterns, one per cycle.")
  (pat.span "Make a span from its start and end in cycles.")
  (pat.spancycles "Split a span at the cycle boundaries.")
  (pat.spanend "The end of a span in cycles.")
  (pat.spanintersect "The part that two spans share.")
  (pat.spanlen "The length of a span in cycles.")
  (pat.spanstart "The start of a span in cycles.")
  (pat.stack "Layer patterns on top of each other.")
  (pat.steady "A continuous constant signal.")
  (pat.timecat "Concatenate patterns within a single cycle, each taking a share by its weight.")
  (pat.window "Advance a tick-driven clock at a steady or patterned cps. Gives the cycles of this tick, the seconds at which they start, the cps of each part of them and the cps at their start.")
  (pat.with "Add the values of one pattern to the maps of another, with structure from the first.")
  (sched.filter "Keep the pairs of a schedule whose values satisfy a predicate.")
  (sched.map "Apply a function to the value of each pair of a schedule.")
  (sched.trig "A gate pulse of a fixed length at each pair of a schedule, to start an envelope."))

(layout demo.pat
  (comment9 0 0)
  (number1 700 160)
  (pat.mini2 280 160)
  (pat.plot8 0 240)
  (ref3 560 280)
  (ref4 280 340)
  (ref5 280 460)
  (tick-bang0 560 100)
  (~out7 280 580)
  (~sinosc6 280 520)
  (camera 420 300 1))

(layout demo.pat.cps
  (comment10 301 196)
  (comment11 700 205)
  (comment9 279 -19)
  (pat.mini1 609 160)
