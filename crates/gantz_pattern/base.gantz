  (inlet1 (inlet "function" "combines a value from each pattern"))
  (inlet2 (inlet "pattern" "first pattern, which gives the structure"))
  (inlet3 (inlet "pattern" "second pattern"))
  (outlet4 (outlet "pattern" "combined values where events meet"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> expr0 outlet4))

(graph pat.mergewithr
