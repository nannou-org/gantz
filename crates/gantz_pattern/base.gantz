  (inlet4 (inlet "number" "cps at the cycle point, which a gap in the cps holds"))
  (outlet5 (outlet "cycle" "the moved cycle point"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> inlet4 (expr0 3))
