  (outlet3 (outlet "span" "the part both share, or #f when they share none"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph pat.spanlen
  (expr0 (expr (pat/span-len $s) #:require "gantz/pattern"))
  (inlet1 (inlet "span" "a span"))
  (outlet2 (outlet "number" "length in cycles"))
