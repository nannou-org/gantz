(graph dialer
  (expr0 (expr (ui-elem 'dialer '() (list (list 'bind $?bind) (list 'min $?min) (list 'max $?max) (list 'step $?step) (list 'precision (ui-int $?precision)) (list 'label $?label) (list 'push $?push)) (None)) #:require "gantz/ui"))
  (inlet1 (inlet "path" "path of the number node to edit"))
  (inlet2 (inlet "number" "lower bound"))
  (inlet3 (inlet "number" "upper bound"))
  (inlet4 (inlet "number" "drag step"))
  (inlet5 (inlet "number" "decimal places shown"))
  (inlet6 (inlet "string" "inline label"))
  (inlet7 (inlet "boolean" "push-eval on edit, default #t"))
  (outlet8 (outlet "element" "dialer element"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> inlet4 (expr0 3))
  (-> inlet5 (expr0 4))
  (-> inlet6 (expr0 5))
  (-> inlet7 (expr0 6))
  (-> expr0 outlet8))

(graph div
  (expr0 (expr (/ $l $r)))
  (inlet1 (inlet "number" "left operand"))
  (inlet2 (inlet "number" "right operand"))
  (outlet3 (outlet "number" "quotient"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph empty?
  (expr0 (expr (empty? $list)))
  (inlet1 (inlet "list" "input list"))
  (outlet2 (outlet "boolean" "true if empty"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph eq
  (expr0 (expr (equal? $l $r)))
  (inlet1 (inlet "value" "left value"))
  (inlet2 (inlet "value" "right value"))
  (outlet3 (outlet "boolean" "true if equal"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph first
  (expr0 (expr (car $list)))
  (inlet1 (inlet "list" "input list"))
  (outlet2 (outlet "value" "first element"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph frame
  (expr0 (expr (ui-elem 'frame '() (list (list 'title $?title)) $?children) #:require "gantz/ui"))
  (inlet1 (inlet "list" "child elements, or one element"))
  (inlet2 (inlet "string" "group box title"))
  (outlet3 (outlet "element" "frame element"))
  (-> inlet1 (expr0 1))
  (-> inlet2 expr0)
  (-> expr0 outlet3))

(graph grid
  (expr0 (expr (ui-elem 'grid '() (list (list 'cols (ui-int $?cols)) (list 'gap $?gap)) $?children) #:require "gantz/ui"))
  (inlet1 (inlet "list" "child elements, filled row-major"))
  (inlet2 (inlet "number" "number of columns"))
  (inlet3 (inlet "number" "space between cells"))
  (outlet4 (outlet "element" "grid element"))
  (-> inlet1 (expr0 2))
  (-> inlet2 expr0)
  (-> inlet3 (expr0 1))
  (-> expr0 outlet4))

(graph gt
  (expr0 (expr (> $l $r)))
  (inlet1 (inlet "number" "left operand"))
  (inlet2 (inlet "number" "right operand"))
  (outlet3 (outlet "boolean" "true if left > right"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph gte
  (expr0 (expr (>= $l $r)))
  (inlet1 (inlet "number" "left operand"))
  (inlet2 (inlet "number" "right operand"))
  (outlet3 (outlet "boolean" "true if left >= right"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph label
  (expr0 (expr (ui-elem 'label (list $?text) (list (list 'size $?size) (list 'color $?color)) (None)) #:require "gantz/ui"))
  (inlet1 (inlet "string" "text to display"))
  (inlet2 (inlet "number" "font size"))
  (inlet3 (inlet "string" "text colour as #rrggbb or #rrggbbaa"))
  (outlet4 (outlet "element" "label element"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> expr0 outlet4))

(graph length
  (expr0 (expr (length $list)))
  (inlet1 (inlet "list" "input list"))
  (outlet2 (outlet "number" "element count"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph list-ref
  (expr0 (expr (list-ref $list (exact (round $index)))))
  (inlet1 (inlet "list" "input list"))
  (inlet2 (inlet "number" "zero-based index"))
  (outlet3 (outlet "value" "element at index"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph list?
  (expr0 (expr (list? $x)))
  (inlet1 (inlet "value" "value to test"))
  (outlet2 (outlet "boolean" "true if a list"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph lt
  (expr0 (expr (< $l $r)))
  (inlet1 (inlet "number" "left operand"))
  (inlet2 (inlet "number" "right operand"))
  (outlet3 (outlet "boolean" "true if left < right"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph lte
  (expr0 (expr (<= $l $r)))
  (inlet1 (inlet "number" "left operand"))
  (inlet2 (inlet "number" "right operand"))
  (outlet3 (outlet "boolean" "true if left <= right"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph matrix
  (expr0 (expr (ui-elem 'matrix '() (list (list 'bind $?bind) (list 'cell-size $?cell-size) (list 'push $?push)) (None)) #:require "gantz/ui"))
  (inlet1 (inlet "path" "path of the node whose rows of cells to edit"))
  (inlet2 (inlet "number" "cell size in points"))
  (inlet3 (inlet "boolean" "push-eval on edit, default #t"))
  (outlet4 (outlet "element" "matrix element"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> expr0 outlet4))

(graph mod
  (expr0 (expr (let
  ((n (exact (round $l)))
   (d (exact (round $r))))
  (if (zero? d) n (modulo n d)))))
  (inlet1 (inlet "number" "left operand"))
  (inlet2 (inlet "number" "right operand"))
  (outlet3 (outlet "number" "remainder"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph mul
  (expr0 (expr (* $l $r)))
  (inlet1 (inlet "number" "left operand"))
  (inlet2 (inlet "number" "right operand"))
  (outlet3 (outlet "number" "product"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph neg
  (expr0 (expr (- 0 $x)))
  (inlet1 (inlet "number" "value to negate"))
  (outlet2 (outlet "number" "negated value"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph neq
  (expr0 (expr (not (equal? $l $r))))
  (inlet1 (inlet "value" "left value"))
  (inlet2 (inlet "value" "right value"))
  (outlet3 (outlet "boolean" "true if not equal"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph not
  (expr0 (expr (not $x)))
  (inlet1 (inlet "boolean" "value to invert"))
  (outlet2 (outlet "boolean" "logical negation"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph number?
  (expr0 (expr (number? $x)))
  (inlet1 (inlet "value" "value to test"))
  (outlet2 (outlet "boolean" "true if a number"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph or
  (expr0 (expr (if $l $l $r)))
  (inlet1 (inlet "boolean" "left operand"))
  (inlet2 (inlet "boolean" "right operand"))
  (outlet3 (outlet "boolean" "true if either is truthy"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph plot
  (expr0 (expr (ui-elem 'plot '() (list (list 'bind $?bind) (list 'mode $?mode) (list 'style $?style) (list 'color $?color) (list 'grid $?grid) (list 'axes $?axes) (list 'interactive $?interactive) (list 'y-min $?y-min) (list 'y-max $?y-max) (list 'w $?w) (list 'h $?h)) (None)) #:require "gantz/ui"))
  (inlet1 (inlet "path" "path of the node whose state to plot"))
  (inlet2 (inlet "symbol" "scope or signal"))
  (inlet3 (inlet "symbol" "bars or line"))
  (inlet4 (inlet "string" "plot colour as #rrggbb"))
  (inlet5 (inlet "boolean" "show the grid"))
  (inlet6 (inlet "boolean" "show the axes"))
  (inlet7 (inlet "boolean" "allow zoom and pan"))
  (inlet8 (inlet "number" "lower y bound"))
  (inlet9 (inlet "number" "upper y bound"))
  (inlet10 (inlet "number" "width"))
  (inlet11 (inlet "number" "height"))
  (outlet12 (outlet "element" "plot element"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> inlet4 (expr0 3))
  (-> inlet5 (expr0 4))
  (-> inlet6 (expr0 5))
  (-> inlet7 (expr0 6))
  (-> inlet8 (expr0 7))
  (-> inlet9 (expr0 8))
  (-> inlet10 (expr0 9))
  (-> inlet11 (expr0 10))
  (-> expr0 outlet12))

(graph ref-gui
  (expr0 (expr (ui-elem 'ref-gui (list (ui-id $?node)) '() (None)) #:require "gantz/ui"))
  (inlet1 (inlet "path" "path of the instance whose GUI to embed"))
  (outlet2 (outlet "element" "ref-gui element"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph rest
  (expr0 (expr (cdr $list)))
  (inlet1 (inlet "list" "input list"))
  (outlet2 (outlet "list" "all but the first element"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph reverse
  (expr0 (expr (reverse $list)))
  (inlet1 (inlet "list" "input list"))
  (outlet2 (outlet "list" "reversed list"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph row
  (expr0 (expr (ui-elem 'row '() (list (list 'gap $?gap) (list 'align $?align)) $?children) #:require "gantz/ui"))
  (inlet1 (inlet "list" "child elements, or one element"))
  (inlet2 (inlet "number" "space between children"))
  (inlet3 (inlet "symbol" "cross-axis alignment: start, center or end"))
  (outlet4 (outlet "element" "row element"))
  (-> inlet1 (expr0 2))
  (-> inlet2 expr0)
  (-> inlet3 (expr0 1))
  (-> expr0 outlet4))

(graph select
  (expr0 (expr (if $cond $then $else)))
  (inlet1 (inlet "boolean" "condition"))
  (inlet2 (inlet "value" "result if true"))
  (inlet3 (inlet "value" "result if false"))
  (outlet4 (outlet "value" "selected value"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> expr0 outlet4))

(graph sep
  (expr0 (expr (quote (sep))))
  (outlet1 (outlet "element" "sep element"))
  (-> expr0 outlet1))

(graph space
  (expr0 (expr (ui-elem 'space (list $?amount) '() (None)) #:require "gantz/ui"))
  (inlet1 (inlet "number" "amount of space"))
  (outlet2 (outlet "element" "space element"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph string?
  (expr0 (expr (string? $x)))
  (inlet1 (inlet "value" "value to test"))
  (outlet2 (outlet "boolean" "true if a string"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph sub
  (expr0 (expr (- $l $r)))
  (inlet1 (inlet "number" "left operand"))
  (inlet2 (inlet "number" "right operand"))
  (outlet3 (outlet "number" "difference"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph toggle
  (expr0 (expr (ui-elem 'toggle '() (list (list 'bind $?bind) (list 'label $?label) (list 'push $?push)) (None)) #:require "gantz/ui"))
  (inlet1 (inlet "path" "path of the node whose boolean state to edit"))
  (inlet2 (inlet "string" "inline label"))
  (inlet3 (inlet "boolean" "push-eval on edit, default #t"))
  (outlet4 (outlet "element" "toggle element"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> inlet3 (expr0 2))
  (-> expr0 outlet4))

(graph value
  (expr0 (expr (ui-elem 'value '() (list (list 'bind $?bind) (list 'wrap $?wrap)) (None)) #:require "gantz/ui"))
  (inlet1 (inlet "path" "path of the node whose state to show"))
  (inlet2 (inlet "boolean" "wrap long output"))
  (outlet3 (outlet "element" "value element"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

