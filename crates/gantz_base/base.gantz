(graph abs
  (expr0 (expr (abs $x)))
  (inlet1 (inlet "number" "value"))
  (outlet2 (outlet "number" "absolute value"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph add
  (expr0 (expr (+ $l $r)))
  (inlet1 (inlet "number" "left operand"))
  (inlet2 (inlet "number" "right operand"))
  (outlet3 (outlet "number" "sum"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph and
  (expr0 (expr (if $l $r #f)))
  (inlet1 (inlet "boolean" "left operand"))
  (inlet2 (inlet "boolean" "right operand"))
  (outlet3 (outlet "boolean" "true if both are truthy"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph append
  (expr0 (expr (append $l $r)))
  (inlet1 (inlet "list" "first list"))
  (inlet2 (inlet "list" "second list"))
  (outlet3 (outlet "list" "concatenated list"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph button
  (expr0 (expr (ui-elem 'button '() (list (list 'bind $?bind) (list 'label $?label)) (None)) #:require "gantz/ui"))
  (inlet1 (inlet "path" "path of the node to push-eval on press"))
  (inlet2 (inlet "string" "button text"))
  (outlet3 (outlet "element" "button element"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph col
  (expr0 (expr (ui-elem 'col '() (list (list 'gap $?gap) (list 'align $?align)) $?children) #:require "gantz/ui"))
  (inlet1 (inlet "list" "child elements, or one element"))
  (inlet2 (inlet "number" "space between children"))
  (inlet3 (inlet "symbol" "cross-axis alignment: start, center or end"))
  (outlet4 (outlet "element" "col element"))
  (-> inlet1 (expr0 2))
  (-> inlet2 expr0)
  (-> inlet3 (expr0 1))
  (-> expr0 outlet4))

(graph cons
  (expr0 (expr (cons $head $tail)))
  (inlet1 (inlet "value" "new first element"))
  (inlet2 (inlet "list" "rest of the list"))
  (outlet3 (outlet "list" "new list"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

