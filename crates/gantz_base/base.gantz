(graph demo-gui
  (bang0 bang)
  (number1 (number #:no-push-eval))
  (number2 (number #:no-push-eval))
  (ref3 (ref add #:sync))
  (inspect4 inspect)
  (bind5 (bind 1))
  (bind6 (bind 2))
  (bind7 (bind 0))
  (bind8 (bind 4))
  (expr9 (expr "a"))
  (expr10 (expr "b"))
  (expr11 (expr "add"))
  (expr12 (expr "a + b ="))
  (ref13 (ref dialer #:sync))
  (ref14 (ref dialer #:sync))
  (ref15 (ref button #:sync))
  (ref16 (ref label #:sync))
  (ref17 (ref value #:sync))
  (list18 list)
  (ref19 (ref row #:sync))
  (list20 list)
  (ref21 (ref row #:sync))
  (list22 (list #:count 3))
  (ref23 (ref col #:sync))
  (gui24 gui)
  (gui25 (gui view))
  (comment26 (comment "A simple adder graph.\nWe'll make a GUI for this over to the right!" 261 29))
  (comment27 (comment "In gantz you can define your node's GUI as a graph too." 327 15))
  (comment28 (comment "A `bind` node allows for binding to the state of another node.\nYou can change what node it binds to in the Node Inspector pane." 470 29))
  (comment29 (comment "Element nodes such as `dialer`, `button`, `label` and `value` build the tree.\nSmall literals such as labels come from `expr` nodes." 438 29))
  (comment30 (comment "`list` gathers the children of a `row` or `col`.\nYou can set its input count in the Node Inspector pane." 329 29))
  (comment31 (comment "A `gui` node declares the tree wired into it as this graph's GUI.\n\ngui[body] - the GUI shown in the node's body.\ngui[view] - the GUI shown when popping out a node's GUI into a pane.\n\nOpen the \"GUI Preview\" pane to see the rendered GUI.\nOpen the \"GUI Tree\" pane to see the tree as text." 440 106))
  (comment32 (comment "See the `demo-gui-compose` node for an example of how this node can be used." 469 15))
  (-> bang0 number1)
  (-> bang0 number2)
  (-> number1 ref3)
  (-> number2 (ref3 1))
  (-> ref3 inspect4)
  (-> bind5 ref13)
  (-> expr9 (ref13 5))
  (-> bind6 ref14)
  (-> expr10 (ref14 5))
  (-> bind7 ref15)
  (-> expr11 (ref15 1))
  (-> expr12 ref16)
  (-> bind8 ref17)
  (-> ref13 list18)
  (-> ref14 (list18 1))
  (-> list18 ref19)
  (-> ref16 list20)
  (-> ref17 (list20 1))
  (-> list20 ref21)
  (-> ref19 list22)
  (-> ref15 (list22 1))
  (-> ref21 (list22 2))
  (-> list22 ref23)
  (-> ref23 gui24)
  (-> ref23 gui25))

(graph demo-gui-compose
  (comment0 (comment "Make sure to open the \"GUI Preview\" panel so you can preview the resulting GUI!" 472 15))
  (ref1 (ref demo-gui #:sync))
  (ref2 (ref demo-gui #:sync))
  (number3 (number #:min 0 #:max 1))
  (expr4 (expr (if (> $t 0.5) "t is high" "t is low")))
  (ref5 (ref label #:sync))
  (bind6 (bind 3))
  (expr7 (expr "t"))
  (expr8 (expr 0.0))
  (expr9 (expr 1.0))
  (ref10 (ref dialer #:sync))
  (bind11 (bind 1))
  (ref12 (ref ref-gui #:sync))
  (bind13 (bind 2))
  (ref14 (ref ref-gui #:sync))
  (list15 list)
  (ref16 (ref row #:sync))
  (list17 (list #:count 3))
  (ref18 (ref col #:sync))
  (gui19 gui)
  (comment20 (comment "Our two instances of the `demo-gui` node.\nOur graph on the right will compose these into a new combined GUI!" 256 44))
  (comment21 (comment "`ref-gui` embeds the GUI of the node instance that its `bind` input points to, allowing for arbitrary nesting and composition of GUI!" 340 44))
  (comment22 (comment "In gantz, you can combine the GUIs of nested nodes." 311 15))
  (comment23 (comment "This example composes two instances of our `demo-gui` node." 366 15))
  (comment24 (comment "Checkout `demo-gui` first!" 163 15))
  (comment25 (comment "The `gui[body]` node will automatically pull evaluation as needed, however we can also manually push evaluation if we wish." 384 30))
  (comment26 (comment "The GUI can also respond to values from graph evaluation.\nThe label text is the one place an `expr` still does the work here." 384 30))
  (-> ref18 gui19)
  (-> number3 expr4)
  (-> expr4 ref5)
  (-> bind6 ref10)
  (-> expr8 (ref10 1))
  (-> expr9 (ref10 2))
  (-> expr7 (ref10 5))
  (-> bind11 ref12)
  (-> bind13 ref14)
  (-> ref12 list15)
  (-> ref14 (list15 1))
  (-> list15 ref16)
  (-> ref5 list17)
  (-> ref10 (list17 1))
  (-> ref16 (list17 2))
  (-> list17 ref18))

