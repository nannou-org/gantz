(graph abs
  (expr0 (expr (abs $x)))
  (inlet1 (inlet "number" "value"))
  (outlet2 (outlet "number" "absolute value"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph add
  (expr0 (expr (+ $l $r)))
  (inlet1 (inlet "number" "left operand"))
  (inlet2 (inlet "number" "right operand"))
  (outlet3 (outlet "number" "sum"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph all
  (expr0 (expr (list/all $f $list) #:require "gantz/list"))
  (inlet1 (inlet "function" "item predicate"))
  (inlet2 (inlet "list" "input list"))
  (outlet3 (outlet "boolean" "true if every item satisfies the predicate"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph and
  (expr0 (expr (if $l $r #f)))
  (inlet1 (inlet "boolean" "left operand"))
  (inlet2 (inlet "boolean" "right operand"))
  (outlet3 (outlet "boolean" "true if both are truthy"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph any
  (expr0 (expr (list/any $f $list) #:require "gantz/list"))
  (inlet1 (inlet "function" "item predicate"))
  (inlet2 (inlet "list" "input list"))
  (outlet3 (outlet "boolean" "true if any item satisfies the predicate"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph append
  (expr0 (expr (append $l $r)))
  (inlet1 (inlet "list" "first list"))
  (inlet2 (inlet "list" "second list"))
  (outlet3 (outlet "list" "concatenated list"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

(graph concat
  (expr0 (expr (list/concat $lists) #:require "gantz/list"))
  (inlet1 (inlet "list" "a list of lists, or one list per wire"))
  (outlet2 (outlet "list" "items of each list in order"))
  (-> inlet1 expr0)
  (-> expr0 outlet2))

(graph cons
  (expr0 (expr (cons $head $tail)))
  (inlet1 (inlet "value" "new first element"))
  (inlet2 (inlet "list" "rest of the list"))
  (outlet3 (outlet "list" "new list"))
  (-> inlet1 expr0)
  (-> inlet2 (expr0 1))
  (-> expr0 outlet3))

