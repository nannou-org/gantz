(graph demo-freeverb
  (comment0 (comment "Reverb.\nDial the wet mix." 100 30))
  (number1 (number #:min 0.5 #:max 1))
  (~dust2 ~dust)
  (~ringz3 ~ringz)
  (~freeverb4 ~freeverb)
  (~out5 ~out)
  (-> number1 (~freeverb4 1))
  (-> ~dust2 ~ringz3)
  (-> ~ringz3 ~freeverb4)
  (-> ~freeverb4 ~out5))

(graph demo-kick
  (comment0 (comment "Kick drum.\nDial the tempo, then shape the envelopes." 180 30))
  (number1 (number #:min 0.5 #:max 8))
  (~impulse2 (~impulse #:rate kr))
  (~envgen3 (~envgen #:init 50 #:segs ((230 0.001) (50 0.15 -8)) #:rate kr))
  (~envgen4 (~envgen #:segs ((1 0.001) (0 0.4 -4)) #:rate kr))
  (~sinosc5 ~sinosc)
  (~mul6 ~mul)
  (~out7 ~out)
  (-> number1 ~impulse2)
  (-> ~impulse2 ~envgen3)
  (-> ~impulse2 ~envgen4)
  (-> ~envgen3 ~sinosc5)
  (-> ~sinosc5 ~mul6)
  (-> ~envgen4 (~mul6 1))
  (-> ~mul6 ~out7))

(graph demo-looper
  (comment0 (comment "Looper.\nDial the playback speed." 110 30))
  (number1 (number #:min 0.5))
  (~dust2 ~dust)
  (~ringz3 ~ringz)
  (~buffer4 ~buffer)
  (~recordbuf5 ~recordbuf)
  (~playbuf6 ~playbuf)
  (~out7 ~out)
  (-> number1 (~playbuf6 1))
  (-> ~dust2 ~ringz3)
  (-> ~ringz3 (~recordbuf5 6))
  (-> ~buffer4 ~recordbuf5)
  (-> ~buffer4 ~playbuf6)
  (-> ~playbuf6 ~out7))

(graph demo-pluck
  (comment0 (comment "Plucked string.\nDial the pluck rate and the string period." 200 30))
  (number1 (number #:min 2))
  (number2 (number #:min 0.0045 #:max 0.05))
  (~whitenoise3 ~whitenoise)
  (~dust4 ~dust)
  (~pluck5 ~pluck)
  (~out6 ~out)
  (bang7 bang)
  (tick-bang8 (tick-bang #:rate 30))
  (-> number1 ~dust4)
  (-> number2 (~pluck5 2))
  (-> ~whitenoise3 ~pluck5)
  (-> ~dust4 (~pluck5 1))
  (-> ~pluck5 ~out6)
  (-> bang7 number1)
  (-> bang7 number2)
  (-> tick-bang8 bang7))

(graph demo-ringmod
  (comment0 (comment "Ring modulation.\nDial the two freqs." 130 30))
  (number1 (number #:min 220))
  (number2 (number #:min 2))
  (~sinosc3 ~sinosc)
  (~sinosc4 ~sinosc)
  (~mul5 ~mul)
  (~out6 ~out)
  (-> number1 ~sinosc3)
  (-> number2 ~sinosc4)
  (-> ~sinosc3 ~mul5)
  (-> ~sinosc4 (~mul5 1))
  (-> ~mul5 ~out6))

(graph demo-samplehold
  (comment0 (comment "Sample and hold.\nDial the step rate and the pitch range." 190 30))
  (number1 (number #:min 8))
  (number2 (number #:min 300))
  (number3 (number #:min 500))
  (~whitenoise4 ~whitenoise)
  (~impulse5 ~impulse)
  (~latch6 ~latch)
  (~muladd7 ~muladd)
  (~sinosc8 ~sinosc)
  (~out9 ~out)
  (tick-bang10 (tick-bang #:rate 30))
  (bang11 bang)
  (-> number1 ~impulse5)
  (-> number2 (~muladd7 1))
  (-> number3 (~muladd7 2))
  (-> ~whitenoise4 ~latch6)
  (-> ~impulse5 (~latch6 1))
  (-> ~latch6 ~muladd7)
  (-> ~muladd7 ~sinosc8)
  (-> ~sinosc8 ~out9)
  (-> tick-bang10 bang11)
  (-> bang11 number1)
  (-> bang11 number2)
  (-> bang11 number3))

(graph demo-sampler
  (comment0 (comment "Sample player.\nSelect the ~sample and press Load.\nDial the playback speed." 230 45))
  (number1 (number #:min 0.5))
  (~sample2 ~sample)
  (~playbuf3 ~playbuf)
  (~out4 ~out)
  (-> number1 (~playbuf3 1))
  (-> ~sample2 ~playbuf3)
  (-> ~playbuf3 ~out4))

(graph demo-sine
  (~sinosc0 ~sinosc)
  (~out1 ~out)
  (-> ~sinosc0 ~out1))

(graph demo-waveshape
  (comment0 (comment "Waveshaping.\nDial the drive." 100 30))
  (number1 (number #:min 1))
  (~sinosc2 ~sinosc)
  (~mul3 ~mul)
  (~tanh4 ~tanh)
  (~out5 ~out)
  (-> number1 (~mul3 1))
  (-> ~sinosc2 ~mul3)
  (-> ~mul3 ~tanh4)
  (-> ~tanh4 ~out5))

(graph demo-wavetable
  (comment0 (comment "Wavetable.\nDial the number of harmonics." 150 30))
  (number1 (number #:min 1 #:max 32))
  (expr2 (expr (transduce (range 0 512) (mapping (lambda (i) (* 0.5 (apply + (transduce (range 1 (+ (exact (round $h)) 1)) (mapping (lambda (k) (/ (sin (/ (* 6.283185307179586 k i) 512)) k))) (into-list)))))) (into-list))))
  (~buffer3 (~buffer #:frames 1024 #:wavetable))
  (~osc4 ~osc)
  (~out5 ~out)
  (-> number1 expr2)
  (-> expr2 ~buffer3)
  (-> ~buffer3 ~osc4)
  (-> ~osc4 ~out5))

(descriptions
  (demo-freeverb "Random impulses ring a resonator into a reverb. Dial the number for the wet mix.")
  (demo-kick "A kick drum. Each impulse starts a pitch envelope on a sine and an amp envelope that shapes it. Dial the number for the tempo. Drag the envelope points to reshape the kick while it plays.")
  (demo-looper "Random impulses record into a buffer that plays back at another speed. Dial the number for the playback speed.")
  (demo-pluck "Noise bursts pluck a Karplus-Strong string. Dial the numbers for the pluck rate and the string period.")
  (demo-ringmod "Two sines multiplied. Dial the numbers to sweep from tremolo to ring modulation.")
  (demo-samplehold "A latch samples white noise on each impulse. The result sets the frequency of a sine. Dial the numbers for the step rate and the pitch range.")
  (demo-sampler "A sample plays in a loop. Select the ~sample node and press Load in its inspector to pick a WAV file. Dial the number for the playback speed.")
  (demo-sine "A sine wave into the audio output - the simplest DSP graph.")
  (demo-waveshape "A sine into a tanh waveshaper. Dial the number to raise the drive.")
  (demo-wavetable "A list of numbers fills a wavetable buffer for an oscillator. Dial the number of harmonics to fill the table and hear the tone change."))

(layout demo-freeverb
  (comment0 -220 0)
  (number1 113 86)
  (~dust2 0 0)
  (~freeverb4 0 160)
  (~out5 0 240)
  (~ringz3 0 80)
  (camera 0 120 1))

