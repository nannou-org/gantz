(graph demo.freeverb
  (comment0 (comment "# reverb\nrandom impulses ring a resonator\ninto a reverb. dial the wet mix." 300 57))
  (number1 (number #:min 0.5 #:max 1 #:label "wet"))
  (~dust2 ~dust)
  (~ringz3 ~ringz)
  (~freeverb4 ~freeverb)
  (~out5 ~out)
  (-> number1 (~freeverb4 1))
  (-> ~dust2 ~ringz3)
  (-> ~ringz3 ~freeverb4)
  (-> ~freeverb4 ~out5))

(graph demo.kick
  (comment0 (comment "# kick drum\ndial the rate. drag the envelope\npoints to reshape the kick." 300 57))
  (number1 (number #:min 0.5 #:max 256 #:label "rate"))
  (~impulse2 (~impulse #:rate kr))
  (~envgen3 (~envgen #:init 50 #:segs ((230 0.001) (50 0.15 -8)) #:rate kr #:x-range (0 0.2) #:y-range (0 250)))
  (~envgen4 (~envgen #:segs ((1 0.001) (0 0.4 -4)) #:rate kr #:x-range (0 0.5)))
  (~sinosc5 ~sinosc)
  (~mul6 ~mul)
  (~out7 ~out)
  (comment8 (comment "pitch" 80 19))
  (comment9 (comment "amp" 80 19))
  (-> number1 ~impulse2)
  (-> ~impulse2 ~envgen3)
  (-> ~impulse2 ~envgen4)
  (-> ~envgen3 ~sinosc5)
  (-> ~sinosc5 ~mul6)
  (-> ~envgen4 (~mul6 1))
  (-> ~mul6 ~out7))

(graph demo.looper
  (comment0 (comment "# looper\nrandom impulses record into a\nbuffer that plays at another speed.\ndial the speed." 300 76))
  (number1 (number #:min 0.5 #:label "speed"))
  (~dust2 ~dust)
  (~ringz3 ~ringz)
  (~buffer4 ~buffer)
  (~recordbuf5 ~recordbuf)
  (~playbuf6 ~playbuf)
  (~out7 ~out)
  (-> number1 (~playbuf6 1))
  (-> ~dust2 ~ringz3)
  (-> ~ringz3 (~recordbuf5 6))
  (-> ~buffer4 ~recordbuf5)
  (-> ~buffer4 ~playbuf6)
  (-> ~playbuf6 ~out7))

(graph demo.pluck
  (comment0 (comment "# pluck\nnoise bursts pluck a string.\ndial the rate and the period." 300 57))
  (number1 (number #:min 2 #:label "rate"))
  (number2 (number #:min 0.0045 #:max 0.05 #:precision 4 #:label "period"))
  (~whitenoise3 ~whitenoise)
  (~dust4 ~dust)
  (~pluck5 ~pluck)
  (~out6 ~out)
  (load-bang7 load-bang)
  (-> number1 ~dust4)
  (-> number2 (~pluck5 2))
  (-> ~whitenoise3 ~pluck5)
  (-> ~dust4 (~pluck5 1))
  (-> ~pluck5 ~out6)
  (-> load-bang7 number1)
  (-> load-bang7 number2))

(graph demo.ringmod
  (comment0 (comment "# ring modulation\ntwo sines multiplied. dial them\nfrom tremolo to ring modulation." 300 57))
  (number1 (number #:min 220 #:label "carrier"))
  (number2 (number #:min 2 #:label "mod"))
  (~sinosc3 ~sinosc)
  (~sinosc4 ~sinosc)
  (~mul5 ~mul)
  (~out6 ~out)
  (load-bang7 load-bang)
  (-> number1 ~sinosc3)
  (-> number2 ~sinosc4)
  (-> ~sinosc3 ~mul5)
  (-> ~sinosc4 (~mul5 1))
  (-> ~mul5 ~out6)
  (-> load-bang7 number1)
  (-> load-bang7 number2))

(graph demo.samplehold
  (comment0 (comment "# sample and hold\nan impulse holds a noise value.\nthe value sets a sine's pitch." 300 57))
  (number1 (number #:min 8 #:label "rate"))
  (number2 (number #:min 300 #:label "lo"))
  (number3 (number #:min 500 #:label "hi"))
  (~whitenoise4 ~whitenoise)
  (~impulse5 ~impulse)
  (~latch6 ~latch)
  (~muladd7 ~muladd)
  (~sinosc8 ~sinosc)
  (~out9 ~out)
  (load-bang10 load-bang)
  (load-bang11 load-bang)
  (-> number1 ~impulse5)
  (-> number2 (~muladd7 1))
  (-> number3 (~muladd7 2))
  (-> ~whitenoise4 ~latch6)
  (-> ~impulse5 (~latch6 1))
  (-> ~latch6 ~muladd7)
  (-> ~muladd7 ~sinosc8)
  (-> ~sinosc8 ~out9)
  (-> load-bang10 number1)
  (-> load-bang11 number2)
  (-> load-bang11 number3))

(graph demo.sampler
  (comment0 (comment "# sampler\nselect the ~sample node and press\nload. dial the speed." 300 57))
  (number1 (number #:min 0.5 #:label "speed"))
  (~sample2 ~sample)
  (~playbuf3 ~playbuf)
  (~out4 ~out)
  (-> number1 (~playbuf3 1))
  (-> ~sample2 ~playbuf3)
  (-> ~playbuf3 ~out4))

(graph demo.sine
  (comment0 (comment "# sine\na sine wave into the audio output.\ndial the freq." 300 57))
  (load-bang1 load-bang)
  (number2 (number #:min 220 #:max 880 #:label "freq"))
  (~sinosc3 ~sinosc)
  (~out4 ~out)
  (-> load-bang1 number2)
  (-> number2 ~sinosc3)
  (-> ~sinosc3 ~out4))

(graph demo.waveshape
  (comment0 (comment "# waveshaping\na sine into a tanh shaper.\ndial the drive." 300 57))
  (number1 (number #:min 1 #:label "drive"))
  (~sinosc2 ~sinosc)
  (~mul3 ~mul)
  (~tanh4 ~tanh)
  (~out5 ~out)
  (-> number1 (~mul3 1))
  (-> ~sinosc2 ~mul3)
  (-> ~mul3 ~tanh4)
  (-> ~tanh4 ~out5))

(graph demo.wavetable
  (comment0 (comment "# wavetable\ndial the harmonics. the table fills\nwith a saw wave of that many partials." 320 57))
  (number1 (number #:min 1 #:max 32 #:label "harmonics"))
  (ref2 (ref saw-table #:sync))
  (~buffer3 (~buffer #:frames 1024 #:wavetable))
  (~osc4 ~osc)
  (~out5 ~out)
  (load-bang6 load-bang)
  (comment7 (comment "a graph of its own. open it to see its steps." 200 38))
  (-> number1 ref2)
  (-> ref2 ~buffer3)
  (-> ~buffer3 ~osc4)
  (-> ~osc4 ~out5)
  (-> load-bang6 number1))

(graph saw-table
  (inlet0 (inlet "number" "the number of partials"))
  (expr1 (expr (range 1 (+ (exact (round $h)) 1))))
  (expr2 (expr (lambda (i)
  (* 0.5 (apply +
    (transduce $ks
      (mapping (lambda (k) (/ (sin (/ (* 6.283185307179586 k i) 512)) k)))
      (into-list)))))))
  (expr3 (expr (transduce (range 0 512) (mapping $sample) (into-list))))
  (outlet4 (outlet "list" "512 points of a saw wave"))
  (comment5 (comment "ks: the partials to sum, 1 to h." 230 38))
  (comment6 (comment "sample: one point of the wave, each partial's sine over its number." 230 57))
  (comment7 (comment "table: 512 points of it." 230 19))
  (-> inlet0 expr1)
  (-> expr1 expr2)
  (-> expr2 expr3)
  (-> expr3 outlet4))

(descriptions
  (demo.freeverb "Random impulses ring a resonator into a reverb. Dial the number for the wet mix.")
  (demo.kick "A kick drum. Each impulse starts a pitch envelope on a sine and an amp envelope that shapes it. Dial the number for the tempo. Drag the envelope points to reshape the kick while it plays.")
  (demo.looper "Random impulses record into a buffer that plays back at another speed. Dial the number for the playback speed.")
  (demo.pluck "Noise bursts pluck a Karplus-Strong string. Dial the numbers for the pluck rate and the string period.")
  (demo.ringmod "Two sines multiplied. Dial the numbers to sweep from tremolo to ring modulation.")
  (demo.samplehold "A latch samples white noise on each impulse. The result sets the frequency of a sine. Dial the numbers for the step rate and the pitch range.")
  (demo.sampler "A sample plays in a loop. Select the ~sample node and press Load in its inspector to pick a WAV file. Dial the number for the playback speed.")
  (demo.sine "A sine wave into the audio output - the simplest DSP graph.")
  (demo.waveshape "A sine into a tanh waveshaper. Dial the number to raise the drive.")
  (demo.wavetable "A list of numbers fills a wavetable buffer for an oscillator. Dial the number of harmonics to fill the table and hear the tone change.")
  (saw-table "A saw wave table of 512 points. It sums h partials, each a sine over its number."))

(layout demo.freeverb
  (comment0 0 0)
  (number1 120 160)
  (~dust2 0 100)
  (~freeverb4 0 220)
  (~out5 0 280)
  (~ringz3 0 160)
  (camera 150 150 1))

(layout demo.kick
  (comment0 0 0)
  (comment8 40 348)
  (comment9 290 348)
  (number1 0 100)
  (~envgen3 0 240)
  (~envgen4 250 240)
  (~impulse2 0 160)
  (~mul6 0 450)
  (~out7 0 510)
  (~sinosc5 0 390)
  (camera 240 260 1))

(layout demo.looper
  (comment0 0 0)
  (number1 290 260)
  (~buffer4 0 180)
  (~dust2 100 120)
  (~out7 100 420)
  (~playbuf6 100 340)
  (~recordbuf5 100 260)
  (~ringz3 100 180)
  (camera 200 220 1))

(layout demo.pluck
  (comment0 0 0)
  (load-bang7 260 100)
  (number1 140 160)
  (number2 260 230)
  (~dust4 140 230)
  (~out6 0 370)
  (~pluck5 0 300)
  (~whitenoise3 0 160)
  (camera 200 200 1))

(layout demo.ringmod
  (comment0 0 0)
  (load-bang7 0 100)
  (number1 0 160)
  (number2 170 160)
  (~mul5 0 280)
  (~out6 0 340)
  (~sinosc3 0 220)
  (~sinosc4 170 220)
  (camera 160 180 1))

(layout demo.samplehold
  (comment0 0 0)
  (load-bang10 130 100)
  (load-bang11 280 230)
  (number1 130 160)
  (number2 280 300)
  (number3 380 300)
  (~impulse5 130 230)
  (~latch6 0 300)
  (~muladd7 0 370)
  (~out9 0 500)
  (~sinosc8 0 440)
  (~whitenoise4 0 230)
  (camera 230 260 1))

(layout demo.sampler
  (comment0 0 0)
  (number1 150 100)
  (~out4 0 260)
  (~playbuf3 0 180)
  (~sample2 0 100)
  (camera 150 140 1))

(layout demo.sine
  (comment0 0 0)
  (load-bang1 0 100)
  (number2 0 160)
  (~out4 0 280)
  (~sinosc3 0 220)
  (camera 150 150 1))

(layout demo.waveshape
  (comment0 0 0)
  (number1 120 100)
  (~mul3 0 170)
  (~out5 0 290)
  (~sinosc2 0 100)
  (~tanh4 0 230)
  (camera 150 160 1))

(layout demo.wavetable
  (comment0 0 0)
  (comment7 150 216)
  (load-bang6 0 100)
  (number1 0 160)
  (ref2 0 220)
  (~buffer3 0 280)
  (~osc4 0 340)
  (~out5 0 400)
  (camera 180 210 1))

(layout saw-table
  (comment5 600 60)
  (comment6 600 120)
  (comment7 600 260)
  (expr1 0 60)
  (expr2 0 120)
  (expr3 0 260)
  (inlet0 0 0)
  (outlet4 0 320)
  (camera 400 170 1))

(demo saw-table "demo.wavetable")
